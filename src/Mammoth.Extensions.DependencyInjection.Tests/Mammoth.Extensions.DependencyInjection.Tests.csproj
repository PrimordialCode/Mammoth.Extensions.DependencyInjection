<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;$(NetCoreFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ServiceProviderExtensions.Reflection.Registration.Tests.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="ServiceProviderExtensions.Reflection.Registration.Tests.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="9.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.1.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mammoth.Extensions.DependencyInjection\Mammoth.Extensions.DependencyInjection.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\test-support\NativeResolverCompilation.cs" Link="NativeResolverCompilation.cs" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Mammoth.Extensions.DependencyInjection.CycleProbe/Mammoth.Extensions.DependencyInjection.CycleProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyCycleProbe" AfterTargets="Build">
    <ItemGroup>
      <CycleProbeFiles Include="../Mammoth.Extensions.DependencyInjection.CycleProbe/bin/$(Configuration)/$(TargetFramework)/*" />
    </ItemGroup>
    <Copy SourceFiles="@(CycleProbeFiles)" DestinationFolder="$(OutDir)CycleProbe" />
  </Target>
</Project>
